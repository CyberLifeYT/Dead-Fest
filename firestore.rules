rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================================================================== helpers

    function signedIn() {
      return request.auth != null;
    }

    /**
     * True when the caller owns the `admin` flag on their own player document.
     *
     * **How the engine evaluates this.** The rules engine evaluates every operand of `&&` - it
     * only folds away a literal `false` on the left. So the `exists()` guard below does NOT stop
     * the `get()` from being evaluated, and a `get()` on a document that does not exist is an
     * evaluation error rather than a clean "no".
     *
     * The practical effect is deliberate: a survivor whose profile document is missing cannot
     * write anything, because the engine cannot tell whether they are an admin. That is the safe
     * way round. The app creates the profile at sign-up and repairs it on the next launch if it
     * is ever missing, so this only ever affects a genuinely broken account - and an admin can
     * fix it from the console.
     */
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /** A number, or zero when the field has never been written. */
    function numberOrZero(value) {
      return value is int ? value : 0;
    }

    /**
     * The keys a write changes, or an empty list when there is no existing document.
     *
     * Every caller has to cope with the document not existing yet, because the rules engine
     * evaluates the update rules even for a write that turns out to be a create. Diffing
     * against a missing document is an evaluation error, not an empty diff.
     */
    function changedKeys() {
      return resource != null && resource.data != null
        ? request.resource.data.diff(resource.data).affectedKeys()
        : [];
    }

    /** True when the write changes only the given keys. */
    function onlyChanged(keys) {
      return resource != null && resource.data != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    /**
     * Fields nobody may change on their own document.
     *
     * The admin flag is the whole point: if a player could write it, they could promote
     * themselves and the entire admin boundary would be a suggestion.
     */
    function touchesAdminFlag() {
      return resource != null && resource.data != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin']);
    }

    /**
     * The global death counter is the one value every client may move, because every death
     * bumps it. It is restricted to a single step in either direction (or two for a double
     * curse) so nobody can inflate it, zero it, or reset the whole document.
     */
    function isGrandTotalBump() {
      return onlyChanged(['grandTotal']) &&
        request.resource.data.grandTotal is int &&
        (request.resource.data.grandTotal - numberOrZero(resource.data.grandTotal) <= 2) &&
        (numberOrZero(resource.data.grandTotal) - request.resource.data.grandTotal <= 1);
    }

    /**
     * Fields a player may write on somebody ELSE's document.
     *
     * Three things cross player boundaries, and all three are the app writing on the client's
     * behalf: the mutual survival reward pays every other survivor, and a curse adds a death
     * and disarms a shield on its target. Nothing else crosses.
     *
     * The comparison is made on the `playerData` map rather than the document, because a diff
     * of the whole document reports `playerData` as a single changed key - the leaf names only
     * show up when the inner map is diffed.
     */
    function isCrossPlayerWrite() {
      return signedIn() &&
        onlyChanged(['playerData']) &&
        request.resource.data.playerData != null &&
        resource.data.playerData != null &&
        request.resource.data.playerData.diff(resource.data.playerData).affectedKeys()
          .hasOnly(['coins', 'bankruptcyLevel', 'shield', 'games']);
    }

    /**
     * True when the document being deleted belongs to [uid].
     *
     * The `resource != null` guard matters: deleting a document that does not exist leaves
     * `resource` null, and reading a field off a null resource is an evaluation error rather
     * than a clean refusal.
     */
    function ownedBy(uid) {
      return resource != null && resource.data != null && resource.data.uid == uid;
    }

    /**
     * True when the image being deleted was uploaded by [uid].
     *
     * `resource.data` is null for a document that does not exist, and reading a field off it is
     * an evaluation error rather than a refusal.
     */
    function uploadedBy(uid) {
      return resource != null && resource.data != null && resource.data.uploaderUid == uid;
    }

    /** True when the signed-in survivor uploaded gallery image [imageId]. */
    function isImageUploader(imageId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/images/$(imageId)) &&
        get(/databases/$(database)/documents/images/$(imageId)).data.uploaderUid == request.auth.uid;
    }

    // ==================================================================== players

    match /users/{uid} {
      // The whole community is visible to any signed-in survivor.
      allow read: if signedIn();

      /**
       * Creating your own profile.
       *
       * The admin flag is pinned to false: nobody may arrive with rights already granted, so
       * promotion is always a deliberate act by somebody who already has them.
       */
      allow create: if isSelf(uid) &&
        (!('admin' in request.resource.data) || request.resource.data.admin == false) &&
        request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'admin', 'playerData', 'username'
        ]);

      /**
       * Updating a document.
       *
       * - An admin may change anything.
       * - A player may change anything on their OWN document except the admin flag.
       * - A player may change only the four cross-player fields on somebody else's.
       */
      allow update: if isAdmin() ||
        (isSelf(uid) && !touchesAdminFlag()) ||
        isCrossPlayerWrite();

      allow delete: if isAdmin();

      /**
       * Personal alerts (v2.1.0): "You were cursed by X", "Your Shield blocked a curse", "An admin
       * removed your image".
       *
       * Anyone signed in may drop an alert into somebody's inbox, but only in their own name and
       * only as unread - the sender is recorded so an alert can't be forged from someone else.
       * Only the owner can read, mark read or clear them.
       */
      match /alerts/{alertId} {
        allow read, delete: if isSelf(uid);

        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly([
            'type', 'title', 'body', 'fromUid', 'fromName', 'createdAt', 'read'
          ]) &&
          request.resource.data.fromUid == request.auth.uid &&
          request.resource.data.read == false &&
          request.resource.data.type is string &&
          request.resource.data.title is string &&
          request.resource.data.title.size() <= 120 &&
          request.resource.data.body is string &&
          request.resource.data.body.size() <= 400;

        allow update: if isSelf(uid) && onlyChanged(['read']);
      }
    }

    // ==================================================================== handle registry

    /**
     * One document per claimed handle, so two survivors can never hold the same one.
     *
     * The registry doubles as the uniqueness lock: a handle is claimed by CREATING its
     * document, and updating an existing one is admin-only. That means a handle already taken
     * cannot be overwritten by a second player - the attempt is an update, and updates are
     * refused.
     */
    match /usernames/{name} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['uid', 'display']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.display is string &&
        request.resource.data.display.size() >= 3 &&
        request.resource.data.display.size() <= 20;

      // Releasing your own handle when you rename. Nobody else's.
      allow delete: if isAdmin() ||
        (signedIn() && ownedBy(request.auth.uid));

      allow update: if isAdmin();
    }

    // ==================================================================== global state

    match /gameState/{doc} {
      allow read: if signedIn();

      /**
       * The global document holds the update URL every survivor is told to download, the
       * economy settings, the sector list and the system switches. Only an admin may write it.
       *
       * The one exception is the global death counter, which every client bumps when somebody
       * dies, and even that is restricted to a single step.
       */
      allow create: if isAdmin();
      allow update: if isAdmin() || isGrandTotalBump();
      allow delete: if isAdmin();
    }

    // ==================================================================== community

    match /eventLog/{id} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'id', 'category', 'message', 'userUid', 'targetUid', 'timestamp'
        ]);
      allow update, delete: if isAdmin();
    }

    /**
     * Group chat (v2.1.0). A message is posted in the sender's own name, the text is capped, and a
     * photo thumbnail must stay small (the full photo lives in imageBlobs). The sender can take
     * their own message back; an admin can remove any.
     */
    match /messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 500 &&
        (!('thumb' in request.resource.data) || request.resource.data.thumb.size() < 100 * 1024);
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (signedIn() && resource != null && resource.data != null &&
          resource.data.senderUid == request.auth.uid);
    }

    /**
     * Votes are opened by an admin and cast by everyone, so a player may update the tally -
     * but only the tally. A player must not be able to rewrite the options or the question.
     */
    match /votes/{id} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['results', 'userVotes']);
    }

    match /archives/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /scratchPrizes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /levelRewards/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ==================================================================== shared images

    match /images/{id} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.uploaderUid == request.auth.uid &&
        request.resource.data.thumb.size() < 100 * 1024;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && uploadedBy(request.auth.uid));

      /**
       * Reactions (v2.1.2): one per survivor per image, keyed by uid, from a fixed emoji set.
       * The image's uploader may clear them when deleting the image.
       */
      match /reactions/{reactorUid} {
        allow read: if signedIn();
        allow create, update: if isSelf(reactorUid) &&
          request.resource.data.keys().hasOnly(['emoji', 'createdAt']) &&
          request.resource.data.emoji in ['🔥', '💀', '😂', '😮', '❤️', '👍'];
        allow delete: if isSelf(reactorUid) || isAdmin() || isImageUploader(id);
      }

      /**
       * Comments (v2.1.2): posted in your own name, capped at 300 characters. The author, the
       * image's uploader or an admin can delete one.
       */
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly(['uid', 'name', 'avatar', 'text', 'createdAt']) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 300;
        allow delete: if isAdmin() || isImageUploader(id) ||
          (signedIn() && resource != null && resource.data != null && resource.data.uid == request.auth.uid);
      }
    }

    match /imageBlobs/{id} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.uploaderUid == request.auth.uid &&
        request.resource.data.data.size() < 900 * 1024;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && uploadedBy(request.auth.uid));
    }

    // ==================================================================== death evidence (v2.1.3)

    /**
     * Xbox death evidence: screenshots captured by the Dead-Fest Xbox Death Detector on a PC,
     * reviewed by admins in the app.
     *
     *   deathEvidence/{eventId}              metadata + thumbnail (read by every survivor)
     *   deathEvidence/{eventId}/audit/{ms}   append-only history of every submission and decision
     *   deathEvidenceBlobs/{eventId}         the full image
     *
     * The guarantees, all enforced here rather than in the app:
     *  - evidence always arrives as "pending" and uncounted, in the submitter's own name;
     *  - only an admin can verify, reject, correct, remove or restore;
     *  - "verified" and "counted" are the same thing, and changing either must move the player's
     *    death count by exactly one in the SAME commit, so the record and the statistic can never
     *    disagree (a failed commit changes neither);
     *  - a moderation commit can never change anyone's coins;
     *  - every moderation change must write its audit entry in the same commit.
     */
    function deathGames() {
      return ['dying_light', 'dying_light_2', 'dying_light_the_beast', 'world_war_z',
              'dead_island', 'dead_island_riptide', 'dead_island_2', 'state_of_decay_2'];
    }

    function deathEventTypes() {
      return ['self', 'teammate', 'other', 'unknown'];
    }

    function deathStatuses() {
      return ['pending', 'verified', 'rejected', 'removed'];
    }

    function evidenceFields() {
      return ['eventId', 'gameId', 'uid', 'submitterName', 'playerLabel', 'eventType', 'detectedAt',
              'confidence', 'status', 'localRelativePath', 'hasImage', 'thumb', 'width', 'height',
              'sizeBytes', 'createdAt', 'updatedAt', 'counted', 'countedSector', 'subjectUid',
              'reviewedBy', 'reviewerName', 'reviewedAt', 'rejectionReason', 'source', 'detectorVersion'];
    }

    function evidencePath(eventId) {
      return /databases/$(database)/documents/deathEvidence/$(eventId);
    }

    function auditPath(eventId, at) {
      return /databases/$(database)/documents/deathEvidence/$(eventId)/audit/$(string(at));
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function deathsIn(data, sector) {
      return data.get('playerData', {}).get('games', {}).get(sector, {}).get('deaths', 0);
    }

    function coinsIn(data) {
      return data.get('playerData', {}).get('coins', 0);
    }

    function deathsBefore(uid, sector) {
      return exists(userPath(uid)) ? deathsIn(get(userPath(uid)).data, sector) : 0;
    }

    function deathsAfter(uid, sector) {
      return existsAfter(userPath(uid)) ? deathsIn(getAfter(userPath(uid)).data, sector) : 0;
    }

    function oneMoreDeath(uid, sector) {
      return deathsAfter(uid, sector) == deathsBefore(uid, sector) + 1;
    }

    /** One fewer, or still zero if somebody already took the count to zero. Never negative. */
    function oneLessDeath(uid, sector) {
      return deathsBefore(uid, sector) > 0
        ? deathsAfter(uid, sector) == deathsBefore(uid, sector) - 1
        : deathsAfter(uid, sector) == 0;
    }

    function sameDeaths(uid, sector) {
      return deathsAfter(uid, sector) == deathsBefore(uid, sector);
    }

    /** Death moderation and the economy are separate: a moderation commit never moves coins. */
    function coinsUntouched(uid) {
      return uid == '' || !exists(userPath(uid))
        ? true
        : coinsIn(getAfter(userPath(uid)).data) == coinsIn(get(userPath(uid)).data);
    }

    /**
     * The death count moves exactly as the record's counted flag says: +1 when it becomes
     * counted, -1 when it stops, and -1/+1 when a counted death moves to another player or sector.
     */
    function countingIsConsistent(before, after) {
      return before.counted == true
        ? (after.counted == true
            ? (before.subjectUid == after.subjectUid && before.countedSector == after.countedSector
                ? sameDeaths(after.subjectUid, after.countedSector)
                : oneLessDeath(before.subjectUid, before.countedSector) &&
                  oneMoreDeath(after.subjectUid, after.countedSector))
            : oneLessDeath(before.subjectUid, before.countedSector))
        : (after.counted == true ? oneMoreDeath(after.subjectUid, after.countedSector) : true);
    }

    function validEvidenceText(data) {
      return data.playerLabel is string && data.playerLabel.size() <= 40 &&
        data.submitterName is string && data.submitterName.size() <= 40 &&
        data.source is string && data.source.size() <= 40 &&
        data.detectorVersion is string && data.detectorVersion.size() <= 20 &&
        data.localRelativePath is string && data.localRelativePath.size() <= 200;
    }

    match /deathEvidence/{eventId} {
      allow read: if signedIn();

      /** A detector submitting evidence: always pending, uncounted, unreviewed, in your own name. */
      allow create: if signedIn() &&
        eventId.matches('^[A-Za-z0-9_-]{16,64}$') &&
        request.resource.data.keys().hasOnly(evidenceFields()) &&
        request.resource.data.keys().hasAll(evidenceFields().removeAll(['thumb'])) &&
        request.resource.data.eventId == eventId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.counted == false &&
        request.resource.data.countedSector == '' &&
        request.resource.data.reviewedBy == '' &&
        request.resource.data.reviewerName == '' &&
        request.resource.data.reviewedAt == 0 &&
        request.resource.data.rejectionReason == '' &&
        request.resource.data.subjectUid in ['', request.auth.uid] &&
        request.resource.data.gameId in deathGames() &&
        request.resource.data.eventType in deathEventTypes() &&
        request.resource.data.detectedAt is int &&
        request.resource.data.createdAt is int &&
        request.resource.data.updatedAt == request.resource.data.createdAt &&
        request.resource.data.confidence is number &&
        request.resource.data.confidence >= 0 &&
        request.resource.data.confidence <= 1 &&
        request.resource.data.width is int &&
        request.resource.data.height is int &&
        request.resource.data.sizeBytes is int &&
        validEvidenceText(request.resource.data) &&
        // A relative path inside one game folder: no drive letters, no "..", no absolute paths.
        request.resource.data.localRelativePath.matches('^[A-Za-z0-9]+/[A-Za-z0-9_.-]+[.](png|jpg)$') &&
        !request.resource.data.localRelativePath.matches('.*[.][.].*') &&
        request.resource.data.hasImage is bool &&
        (request.resource.data.hasImage
          ? request.resource.data.thumb is bytes && request.resource.data.thumb.size() < 100 * 1024
          : true) &&
        existsAfter(auditPath(eventId, request.resource.data.createdAt));

      /** Admin moderation: verify, reject, correct, remove, restore. */
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'counted', 'countedSector', 'subjectUid', 'gameId', 'eventType', 'playerLabel',
          'reviewedBy', 'reviewerName', 'reviewedAt', 'rejectionReason', 'updatedAt'
        ]) &&
        request.resource.data.status in deathStatuses() &&
        request.resource.data.gameId in deathGames() &&
        request.resource.data.eventType in deathEventTypes() &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.reviewedAt is int &&
        request.resource.data.updatedAt is int &&
        request.resource.data.updatedAt > resource.data.updatedAt &&
        request.resource.data.countedSector is string &&
        request.resource.data.countedSector.size() <= 80 &&
        request.resource.data.playerLabel is string &&
        request.resource.data.playerLabel.size() <= 40 &&
        request.resource.data.reviewerName is string &&
        request.resource.data.reviewerName.size() <= 40 &&
        request.resource.data.rejectionReason is string &&
        request.resource.data.rejectionReason.size() <= 200 &&
        request.resource.data.subjectUid is string &&
        request.resource.data.counted is bool &&
        // Verified means counted, and counted means verified.
        request.resource.data.counted == (request.resource.data.status == 'verified') &&
        (request.resource.data.counted
          ? request.resource.data.subjectUid != '' &&
            request.resource.data.countedSector != '' &&
            exists(userPath(request.resource.data.subjectUid))
          : true) &&
        countingIsConsistent(resource.data, request.resource.data) &&
        coinsUntouched(resource.data.subjectUid) &&
        coinsUntouched(request.resource.data.subjectUid) &&
        existsAfter(auditPath(eventId, request.resource.data.updatedAt));

      /**
       * Permanent deletion is for uncounted records only (reject or remove it first, so the death
       * count is corrected). The submitter may withdraw their own evidence while it is pending.
       */
      allow delete: if resource != null && resource.data != null &&
        resource.data.counted == false &&
        (isAdmin() || (isSelf(resource.data.uid) && resource.data.status == 'pending'));

      /** Append-only history. Admins write decisions; a submitter writes only the "submitted" entry. */
      match /audit/{auditId} {
        allow read: if isAdmin() ||
          (signedIn() && (exists(evidencePath(eventId))
            ? get(evidencePath(eventId)).data.uid == request.auth.uid
            : false));

        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly(['action', 'actor', 'actorName', 'at', 'note', 'changes']) &&
          request.resource.data.keys().hasAll(['action', 'actor', 'at']) &&
          request.resource.data.actor == request.auth.uid &&
          request.resource.data.at is int &&
          auditId == string(request.resource.data.at) &&
          request.resource.data.action in ['submitted', 'verified', 'rejected', 'corrected', 'removed', 'restored', 'deleted'] &&
          request.resource.data.get('note', '') is string &&
          request.resource.data.get('note', '').size() <= 300 &&
          (isAdmin() ||
            (request.resource.data.action == 'submitted' &&
             !exists(evidencePath(eventId)) &&
             (existsAfter(evidencePath(eventId))
               ? getAfter(evidencePath(eventId)).data.uid == request.auth.uid
               : false)));

        allow update, delete: if false;
      }
    }

    match /deathEvidenceBlobs/{eventId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['data', 'uid']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.data is bytes &&
        request.resource.data.data.size() < 900 * 1024 &&
        (existsAfter(evidencePath(eventId))
          ? getAfter(evidencePath(eventId)).data.uid == request.auth.uid
          : false);

      allow update: if false;

      /** Admins may delete an image; a submitter only together with withdrawing the record. */
      allow delete: if isAdmin() ||
        (signedIn() && ownedBy(request.auth.uid) && !existsAfter(evidencePath(eventId)));
    }

    // ==================================================================== game requests

    /**
     * The community game queue.
     *
     * A survivor may ask for a game; only an admin may decide. The creator is recorded so a
     * request cannot be filed in somebody else's name, and a request always enters the queue as
     * pending - a player cannot pre-approve their own suggestion.
     */
    match /gameRequests/{id} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 80;

      allow update, delete: if isAdmin();
    }
  }
}
