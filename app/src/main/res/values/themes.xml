<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Dark from the very first frame.

        windowBackground matches the Compose ink base exactly, so the cold-start paint and the app
        background are the same colour: no white flash while Compose starts, and no seam when the
        launcher hands over to the app.

        The status/navigation bars are painted to the same ink colour and explicitly marked as
        light-on-dark. The light-status-bar flags are API 27+/29+ attributes; compileSdk knows them
        and older devices simply ignore them.
    -->
    <style name="Theme.DeadFest" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink_0</item>
        <item name="android:colorBackground">@color/ink_0</item>
        <item name="android:statusBarColor">@color/ink_0</item>
        <item name="android:navigationBarColor">@color/ink_0</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/text_hi</item>
        <item name="android:colorAccent">@color/ember</item>
        <!-- The app is dark by design; never let the platform auto-darken it. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!--
        Cold-start splash.

        Below Android 12 there was no splash at all: the user saw the flat window background until
        Compose drew its first frame. From Android 12 the system invents one from the launcher icon,
        which meant the splash looked different on every Android version. `Theme.SplashScreen` from
        androidx.core:core-splashscreen backports the same branded splash all the way to API 24, so
        the skull, the ink background and the hand-off into the app are identical everywhere.

        The post-splash theme is the real app theme, so nothing has to be re-applied afterwards.
    -->
    <style name="Theme.DeadFest.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink_0</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.DeadFest</item>
    </style>
</resources>
