<?xml version="1.0" encoding="utf-8"?>
<!--
    XML-side palette.

    Compose owns the real design system (ui/theme/Color.kt). These few entries exist only for the
    things the platform resolves before any Kotlin runs: the cold-start window, the system bars and
    the launcher icon. Keeping them in sync with the Compose ink/ember scale is what stops a colour
    seam appearing between the launcher and the first composed frame.
-->
<resources>
    <color name="ink_0">#FF08080A</color>
    <color name="ink_2">#FF121216</color>
    <color name="ember">#FFFF4B4B</color>
    <color name="text_hi">#FFF2F2F6</color>

    <!-- Retained: referenced by the platform theme and by notification/vector defaults. -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <!-- Tint for notification icons and action buttons (the default ember). -->
    <color name="notification_accent">#FFFF4B4B</color>
</resources>
