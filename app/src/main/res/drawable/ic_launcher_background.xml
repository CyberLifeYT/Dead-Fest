<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon background layer: deep ink with a warm ember bloom behind the skull.
    Replaces the stock Android Studio template (#3DDC84 green). Vector + gradient only, so it
    scales to every density from one ~600 byte file.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- base -->
    <path
        android:fillColor="#0B0709"
        android:pathData="M0,0h108v108h-108z" />
    <!-- ember bloom -->
    <path android:pathData="M54,8A46,46 0 0 0 54,100A46,46 0 0 0 54,8Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="52"
                android:gradientRadius="54">
                <item android:offset="0" android:color="#57FF4B4B" />
                <item android:offset="0.55" android:color="#26FF8A5B" />
                <item android:offset="1" android:color="#00FF4B4B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
